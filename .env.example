# Copy to .env and adjust as needed.
UI_BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://jsonplaceholder.typicode.com
UI_USERNAME=tomsmith
UI_PASSWORD=SuperSecretPassword!
DEFAULT_ACTION_TIMEOUT_MS=10000
DEFAULT_NAVIGATION_TIMEOUT_MS=30000
LOG_LEVEL=info

# Selects which *_LOCAL / *_QA / *_STAGE variable set below is used. One of: local, qa, stage.
# Usage: ENV=qa npm test
ENV=local

# Shop API (src/api/AuthApiClient.ts etc.) — per-environment base URL and credentials.
# SHOP_API_PASSWORD_* has no default and must be set in your own .env (gitignored, never committed).
SHOP_API_BASE_URL_LOCAL=https://dummyjson.com
SHOP_API_USERNAME_LOCAL=emilys
SHOP_API_PASSWORD_LOCAL=

SHOP_API_BASE_URL_QA=https://dummyjson.com
SHOP_API_USERNAME_QA=emilys
SHOP_API_PASSWORD_QA=

SHOP_API_BASE_URL_STAGE=https://dummyjson.com
SHOP_API_USERNAME_STAGE=emilys
SHOP_API_PASSWORD_STAGE=
